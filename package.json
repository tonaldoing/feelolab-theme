{
  "name": "feelolab",
  "private": true,
  "description": "Starter WordPress de Feelo. Scripts de desarrollo: WordPress local sin Docker (Playground) y chequeos de accesibilidad.",
  "scripts": {
    "dev": "wp-playground-cli server --blueprint=./blueprint.json --mount=./feelolab:/wordpress/wp-content/themes/feelolab --mount=./feelolab-core:/wordpress/wp-content/plugins/feelolab-core --mount=./dev:/wordpress/dev --port=9400",
    "dev:woo": "wp-playground-cli server --blueprint=./dev/blueprint-woo.json --mount=./feelolab:/wordpress/wp-content/themes/feelolab --mount=./feelolab-core:/wordpress/wp-content/plugins/feelolab-core --mount=./dev:/wordpress/dev --port=9400",
    "lint:php": "composer lint",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "lighthouse": "node dev/lighthouse-check.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "build:wporg": "bash dev/build-wporg.sh",
    "i18n": "bash dev/i18n.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@wp-playground/cli": "^3.0.0",
    "lighthouse": "^13.5.0",
    "pa11y-ci": "^3.1.0",
    "playwright-core": "^1.63.0"
  }
}
