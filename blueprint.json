{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "es_AR"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "advanced-custom-fields"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "feelolab-core/feelolab-core.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "feelolab"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/",
        "blogname": "Estudio Demo",
        "blogdescription": "Soluciones claras para tu negocio"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/dev/demo-content.php';"
    }
  ]
}
