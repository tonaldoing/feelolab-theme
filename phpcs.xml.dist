<?xml version="1.0"?>
<ruleset name="Feelolab">
	<description>WordPress Coding Standards + compatibilidad PHP 8.1+.</description>

	<file>feelolab</file>
	<file>feelolab-core</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Clases en src/ siguen PSR-4 (Feelo\Core\Settings\SiteSettings.php), no class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Comentarios en español y sin punto final obligatorio en cada línea. -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
		<!-- Las firmas llevan tipos nativos: no repetimos cada @param en el docblock. -->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<!-- Arrays cortos en una línea son más legibles en definiciones de campos. -->
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="feelolab"/>
				<element value="feelolab-core"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="feelolab"/>
				<element value="feelo"/>
				<element value="Feelo\Core"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
