msgid_plural "Importar %d productos"
msgstr[0] "Import %d product"
msgstr[1] "Import %d products"

msgid "Cancelar y subir otro archivo"
msgstr "Cancel and upload another file"

msgid "No cierres esta pestaña mientras importa. Si se corta, volvé a esta pantalla y seguí desde donde quedó."
msgstr "Don't close this tab while importing. If it stops, come back to this screen and continue from where it left off."

msgid "Importación terminada"
msgstr "Import finished"

msgid "%d producto nuevo"
msgid_plural "%d productos nuevos"
msgstr[0] "%d new product"
msgstr[1] "%d new products"

