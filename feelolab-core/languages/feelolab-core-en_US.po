msgstr "To review"

msgid "Ver los productos"
msgstr "View products"

msgid "Importar otra planilla"
msgstr "Import another spreadsheet"

msgid "Importando: %1$d de %2$d…"
msgstr "Importing: %1$d of %2$d…"

msgid "Se cortó la conexión. Tocá \"Seguir importando\" para continuar desde donde quedó."
msgstr "The connection dropped. Tap \"Continue importing\" to resume from where it left off."

msgid "Seguir importando"
msgstr "Continue importing"

msgid "No tenés permisos para importar."
msgstr "You don't have permission to import."

msgid "Fila %d:"
msgstr "Row %d:"

msgid "no tiene título, se salteó."
msgstr "has no title, it was skipped."

msgid "no se pudo usar la foto \"%1$s\" (%2$s)."
msgstr "couldn't use the photo \"%1$s\" (%2$s)."

